{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devils Rage",
  "version": "0.1.0",
  "identifier": "com.tsawind.devilsrage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "Tsawind",
    "shortDescription": "Devil's Rage corp mapper",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY",
      "endpoints": [
        "https://raw.githubusercontent.com/tsawind/devils-rage-app/updates/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
